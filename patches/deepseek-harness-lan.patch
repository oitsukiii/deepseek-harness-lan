--- a/packages/bundle/web-app/src/startup.ts
+++ b/packages/bundle/web-app/src/startup.ts
@@ -71,8 +71,10 @@ export function apply(ctx: Context): void {
   const program = webCommand()
   program.action(() => {
     const options = program.opts<WebOptions>()
+    // Local patch: allow explicit LAN binds (e.g. --host 192.168.1.100) so the
+    // UI can be reached from home devices. 0.0.0.0 wildcard remains a usage error.
     if (options.host === '0.0.0.0') {
-      program.error('error: --host 0.0.0.0 is intentionally not supported yet for safety: it would expose remote code execution to the network; use 127.0.0.1 instead')
+      program.error('error: --host 0.0.0.0 wildcard is intentionally not supported for safety: it would expose remote code execution to the whole network; pass a specific LAN IP instead')
     }
     if (options.port !== undefined && !/^\d+$/.test(options.port)) {
       program.error(`error: --port must be a number, got ${JSON.stringify(options.port)}`)
