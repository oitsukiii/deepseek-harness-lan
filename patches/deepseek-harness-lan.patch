# deepseek-harness-lan patch
# Target: deepseek-harness 0.1.1-rc.2 (commit b150a55)
# What:   allow binding the dsh web UI to a specific LAN IP + trust it
#         (4 files: webserver host schema, web-app CLI, web entry polyfill,
#          client-connection privileged-method trust)
# Apply:  git apply deepseek-harness-lan.patch   (or use ../apply.sh)
# Revert: git apply -R deepseek-harness-lan.patch (or use ../revert.sh)
#
diff --git a/apps/web/src/main.ts b/apps/web/src/main.ts
index 7359ce5..3663375 100644
--- a/apps/web/src/main.ts
+++ b/apps/web/src/main.ts
@@ -3,6 +3,23 @@
  * module-table seeding, the boot page, and the UI-renderer handoff — lives
  * in @deepseek-ai/dsh-client-web; this file only finds the mount point.
  */
+// Local patch: crypto.randomUUID is only available in secure contexts
+// (HTTPS or localhost). When dsh is served over plain HTTP on a LAN IP
+// (e.g. http://192.168.1.100:3080), provide a standards-shaped fallback so
+// provider-directory loading and other client code keeps working.
+if (typeof globalThis.crypto === 'object' && typeof globalThis.crypto.randomUUID !== 'function') {
+  try {
+    globalThis.crypto.randomUUID = (() =>
+      'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, (c) => {
+        const r = (Math.random() * 16) | 0
+        const v = c === 'x' ? r : (r & 0x3) | 0x8
+        return v.toString(16)
+      })) as typeof globalThis.crypto.randomUUID
+  } catch {
+    // crypto may be read-only in exotic embeds; leave the missing function
+    // and let the caller surface its own error.
+  }
+}
 import { AppWebEntry } from '@deepseek-ai/dsh-client-web'
 
 const el = document.getElementById('root')
diff --git a/packages/bundle/web-app/src/startup.ts b/packages/bundle/web-app/src/startup.ts
